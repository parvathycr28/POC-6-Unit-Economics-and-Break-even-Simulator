          </section>


          <section className="insight-card">

            <div className="panel-kicker">
              DRIVER WATCH
            </div>

            <div className="driver-list">

              <div>
                <span>Price</span>
                <span className="driver-positive">
                  REVENUE
                </span>
              </div>

              <div>
                <span>Variable cost</span>
                <span className="driver-negative">
                  MARGIN
                </span>
              </div>

              <div>
                <span>Fixed cost</span>
                <span className="driver-warning">
                  ABSORPTION
                </span>
              </div>

              <div>
                <span>CAC</span>
                <span className="driver-positive">
                  EFFICIENCY
                </span>
              </div>

              <div>
                <span>Retention</span>
                <span className="driver-positive">
                  LTV
                </span>
              </div>

            </div>

          </section>


          <button
            type="button"
            className="intelligence-hint"
            onClick={() => setIntelligence("waterfall")}
          >
            <span>
              Click any visualization
            </span>

            <strong>
              OPEN INTELLIGENCE →
            </strong>
          </button>

        </aside>

      </section>


      


      {/* =====================================================
          INTELLIGENCE SLIDE OVER
      ===================================================== */}

      <IntelligencePanel
        intelligence={intelligence}
        simulation={simulation}
        scenario={scenario}
        onClose={() => setIntelligence(null)}
      />

    </main>
  );
}
