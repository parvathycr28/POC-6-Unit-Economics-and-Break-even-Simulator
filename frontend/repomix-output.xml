      <section className="dashboard-layout">


        {/* =================================================
            LEFT — SCENARIO CONTROLS
        ================================================= */}

        <aside className="scenario-sidebar">

          <div className="sidebar-heading">

            <div>

              <div className="panel-kicker">
                SCENARIO LAB
              </div>

              <h3>
