"use client";

import { FredSeries } from "@/lib/types";

function formatValue(
  series: FredSeries
) {
  if (series.latest === null) {
    return "—";
  }

  if (series.id === "CPIAUCSL") {
    return series.latest.toFixed(1);
  }

  return `${series.latest.toFixed(2)}%`;
}

function Metric({
  label,
  value,
  description,
}: {
  label: string;
  value: string;
  description: string;
}) {
  return (
    <div className="terminal-card p-4">
      <div className="terminal-kicker">
        {label}
      </div>

      <div className="mt-2 text-2xl font-semibold tracking-tight text-white">
        {value}
      </div>

      <div className="mt-1 text-[10px] text-slate-500">
        {description}
      </div>
    </div>
  );
}

export default function FredMetricCards({
  treasury10y,
  fedFunds,
  cpi,
  unemployment,
  realGdp,
}: {
  treasury10y: FredSeries;
  fedFunds: FredSeries;
  cpi: FredSeries;
  unemployment: FredSeries;
  realGdp: FredSeries;
}) {
  return (
    <div className="grid grid-cols-2 gap-3 lg:grid-cols-5">
      <Metric
        label="10Y TREASURY"
        value={formatValue(treasury10y)}
        description="DGS10 · FRED"
      />

      <Metric
        label="FED FUNDS"
        value={formatValue(fedFunds)}
        description="DFF · FRED"
      />

      <Metric
        label="CPI INDEX"
        value={formatValue(cpi)}
        description="CPIAUCSL · FRED"
      />

      <Metric
        label="UNEMPLOYMENT"
        value={formatValue(unemployment)}
        description="UNRATE · FRED"
      />

      <Metric
        label="REAL GDP"
        value={formatValue(realGdp)}
        description="GDPC1 · FRED"
      />
    </div>
  );
}
