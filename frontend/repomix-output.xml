                </h2>

              </div>


              <button
                type="button"
                className="project-info-close"
                onClick={closeInfo}
                aria-label="Close project information"
              >
                ×
              </button>

            </div>


            {/* DIVIDER */}

            <div className="project-info-divider" />


            {/* DETAILS */}

            <div className="project-info-details">


              <div className="project-info-row">

                <span>
