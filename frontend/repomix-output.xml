<file path="app/components/ContributionWaterfall.tsx">
"use client";

import { SimulationResult } from "@/lib/types";

function money(value: number): string {
  return new Intl.NumberFormat("en-IN", {
    notation: "compact",
    maximumFractionDigits: 1,
  }).format(value);
}

export default function ContributionWaterfall({
  simulation,
  onClick,
}: {
  simulation: SimulationResult;
  onClick: () => void;
}) {
  const rows = [
    {
      number: "01",
      label: "Revenue",
      value: simulation.revenue,
      positive: true,
    },
    {
      number: "02",
      label: "Variable cost",
      value: simulation.variableCostTotal,
      positive: false,
    },
    {
      number: "03",
      label: "Contribution",
      value: simulation.contribution,
      positive: simulation.contribution >= 0,
    },
    {
      number: "04",
      label: "Fixed cost",
      value: simulation.fixedCost,
      positive: false,
    },
    {
      number: "05",
      label: "Operating profit",
      value: Math.abs(simulation.operatingProfit),
      positive: simulation.operatingProfit >= 0,
    },
  ];

  const maxValue = Math.max(
    ...rows.map((row) => Math.abs(row.value)),
    1
  );

  return (
    <button
      type="button"
      onClick={onClick}
      className="
        group
        relative
        flex
        min-h-[350px]
        w-full
        flex-col
        overflow-hidden
        rounded-xl
        border
        border-[#1F2937]
        bg-[#0B1117]
        p-5
        text-left
        transition-all
        duration-300
        hover:border-[#38BDF8]/50
      "
    >
      {/* TOP ACCENT */}
      <div
        className="
          absolute
          left-0
          right-0
          top-0
          h-px
          bg-[#38BDF8]/50
        "
      />

      {/* HEADER */}
      <div className="flex items-start justify-between">
        <div>
          <div
            className="
              text-[11px]
              font-medium
              uppercase
              tracking-[0.18em]
              text-[#38BDF8]
            "
          >
            01 · MARGIN
          </div>

          <div
            className="
              mt-1
              text-[17px]
              font-semibold
              text-white
            "
          >
            Contribution waterfall
          </div>
        </div>

        <div
          className="
            rounded-md
            border
            border-[#1F2937]
            bg-[#030712]
            px-2
            py-1
            text-[9px]
            uppercase
            tracking-[0.15em]
            text-slate-500
            group-hover:text-[#38BDF8]
          "
        >
          Intelligence
        </div>
      </div>

      {/* DIVIDER */}
      <div className="my-4 h-px bg-[#1F2937]" />

      {/* ECONOMICS */}
      <div className="flex flex-1 flex-col justify-between">
        {rows.map((row) => {
          const percentage = Math.max(
            8,
            (Math.abs(row.value) / maxValue) * 100
          );

          return (
            <div
              key={row.label}
              className="
                border-b
                border-[#1F2937]/70
                py-2.5
                last:border-b-0
              "
            >
              {/* HORIZONTAL ROW */}
              <div
                className="
                  flex
                  w-full
                  items-center
                  justify-between
                  gap-4
                "
              >
                {/* LEFT */}
                <div className="flex min-w-0 items-center gap-3">
                  <span
                    className="
                      flex
                      h-7
                      w-7
                      shrink-0
                      items-center
                      justify-center
                      rounded-md
                      border
                      border-[#1F2937]
                      bg-[#030712]
                      text-[9px]
                      font-semibold
                      text-[#38BDF8]
                    "
                  >
                    {row.number}
                  </span>

                  <span
                    className="
                      whitespace-nowrap
                      text-[13px]
                      font-medium
                      text-slate-300
                    "
                  >
                    {row.label}
                  </span>
                </div>

                {/* RIGHT VALUE */}
                <span
                  className={`
                    shrink-0
                    whitespace-nowrap
                    text-right
                    text-[15px]
                    font-semibold
                    tracking-tight
                    ${
                      row.positive
                        ? "text-[#38BDF8]"
                        : "text-slate-300"
                    }
                  `}
                >
                  {!row.positive && "−"}₹{money(row.value)}
                </span>
              </div>

              {/* BAR */}
              <div
                className="
                  ml-10
                  mt-2
                  h-1
                  overflow-hidden
                  rounded-full
                  bg-[#030712]
                "
              >
                <div
                  className={`
                    h-full
                    rounded-full
                    ${
                      row.positive
                        ? "bg-[#38BDF8]"
                        : "bg-slate-600"
                    }
                  `}
                  style={{
                    width: `${percentage}%`,
                    opacity: row.positive ? 0.75 : 0.45,
                  }}
                />
              </div>
            </div>
          );
        })}
      </div>

      {/* FOOTER */}
      <div
        className="
          mt-3
          flex
          items-center
          justify-between
          border-t
          border-[#1F2937]
          pt-3
        "
      >
        <span
          className="
            text-[9px]
            uppercase
            tracking-[0.15em]
            text-slate-600
          "
        >
          Monthly economics
        </span>

        <span
          className="
            text-[9px]
            uppercase
            tracking-[0.15em]
            text-[#38BDF8]/70
          "
        >
          Live scenario
        </span>
      </div>
    </button>
  );
}
